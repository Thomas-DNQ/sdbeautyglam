# Base Postgres (Neon via Vercel, ou Supabase). Sans cette variable, le site tourne en MODE DÉMO (données en mémoire, non sauvegardées).
DATABASE_URL=

# Mot de passe de l'espace gérante (/admin). En mode démo sans valeur : "demo"
ADMIN_PASSWORD=

# Optionnel : recevoir un email à chaque nouvelle demande (https://resend.com)
RESEND_API_KEY=
NOTIFY_EMAIL=

# Numéro WhatsApp de la gérante au format international, sans + (ex : 33612345678)
NEXT_PUBLIC_OWNER_WHATSAPP=

# Adresse publique du site (liens dans les emails)
NEXT_PUBLIC_SITE_URL=
# Expéditeur des emails (domaine vérifié sur Resend)
MAIL_FROM=
# Paiement par carte en ligne (Stripe)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Protection des relances automatiques (Vercel Cron)
CRON_SECRET=
# Module Comptabilité (option) : 1 pour l'activer
FEATURE_COMPTA=
